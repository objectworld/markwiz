<?xml version="1.0" encoding="utf-8"?>
<WixLocalization Culture="ko-KR" xmlns="http://schemas.microsoft.com/wix/2006/localization">
  <String Id="LaunchApp">Markwiz 실행</String>
  <String Id="DowngradeErrorMessage">Markwiz의 최신 버전이 이미 설치되어 있습니다.</String>
  <String Id="PathEnvVarFeature">Markwiz 실행 파일의 설치 위치를 PATH 시스템 환경 변수에 추가합니다. 이렇게 하면 어느 위치에서나 Markwiz 실행 파일을 호출할 수 있습니다.</String>
  <String Id="InstallAppFeature">Markwiz를 설치합니다.</String>
  <String Id="mwAssocTitle">파일 연결</String>
  <String Id="mwAssocDescription">Markdown 파일을 Markwiz로 열지 선택하세요.</String>
  <String Id="mwAssocCheckbox">.md 및 .markdown 파일을 Markwiz로 열기</String>
</WixLocalization>
